# Production Environment Variables for Docker Deployment

# CRITICAL: Change this to a secure random string!
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS

# Client URL for CORS (set to your production domain)
# Examples:
#   - http://localhost:5000 (for Docker testing)
#   - https://yourdomain.com (for production)
CLIENT_URL=http://localhost:5000

# Node Environment
NODE_ENV=production

# Port (default is 5000, matches Docker expose)
PORT=5000
